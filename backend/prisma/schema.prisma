generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Match.id doubles as the short join code used in the shareable link (e.g. "AB3X9K"),
// generated in application code — no separate code column needed.
model Match {
  id                 String          @id
  status             MatchStatus     @default(WAITING)
  currentPlayerIndex Int             @default(0)
  currentRound       Int             @default(1)
  revealedCardId     Int?
  // Set when a K is drawn ("crie uma regra nova, válida até o fim da
  // rodada") — cleared automatically in /advance whenever the round
  // increments, so it never outlives the round it was created in.
  houseRule          String?
  createdAt          DateTime        @default(now())

  players            Player[]
  deck               MatchDeckCard[]
  revealedCard       Card?           @relation("RevealedInMatch", fields: [revealedCardId], references: [id])
}

model Player {
  id        Int    @id @default(autoincrement())
  matchId   String
  name      String
  turnOrder Int

  match     Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, turnOrder])
  @@index([matchId])
}

// Fixed seed deck — a traditional 52-card deck, same cards reused across
// all matches. The rule text is keyed by rank (RULES_BY_RANK in seed.ts),
// so all 4 suits of a given rank share the same rule.
model Card {
  id   Int    @id @default(autoincrement())
  rank String // "A", "2".."10", "J", "Q", "K"
  suit String // "hearts" | "diamonds" | "clubs" | "spades"
  text String // rule tied to this card's rank

  deckEntries    MatchDeckCard[]
  revealedInMatches Match[]      @relation("RevealedInMatch")
}

// Per-match shuffled instance of the deck, so "no repeats until exhausted"
// survives a page refresh instead of living in client memory.
model MatchDeckCard {
  id       Int     @id @default(autoincrement())
  matchId  String
  cardId   Int
  position Int
  drawn    Boolean @default(false)

  match    Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  card     Card    @relation(fields: [cardId], references: [id])

  @@unique([matchId, position])
  @@index([matchId])
}

enum MatchStatus {
  WAITING
  IN_PROGRESS
  FINISHED
}
